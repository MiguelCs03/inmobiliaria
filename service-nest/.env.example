# Firebase Admin SDK — elegir una:
# Opcion A: ruta al archivo JSON (ej: ./firebase-key.json)
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Opcion B: base64 del JSON (recomendado para Railway)
# FIREBASE_SERVICE_ACCOUNT_B64=

# URL del servicio Go (blockchain)
# GO_SERVICE_URL=http://host.docker.internal:3030