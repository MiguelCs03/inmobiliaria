PORT=3000
NODE_ENV=development

# --- Base de datos local (desarrollo) ---
DB_USER=postgres
DB_PASS=
DB_NAME=inmobiliaria
DB_PORT=5434
DB_HOST=localhost

DB_MASTER_HOST=localhost
DB_MASTER_PORT=5434
DB_MASTER_USER=postgres
DB_MASTER_PASS=
DB_MASTER_NAME=inmobiliaria

DB_SLAVE_HOST=localhost
DB_SLAVE_PORT=5434
DB_SLAVE_USER=postgres
DB_SLAVE_PASS=
DB_SLAVE_NAME=inmobiliaria

# --- Base de datos remota (producción, ej: Neon) ---
# Si DATABASE_URL está definida, se usa en lugar de la configuración master/slave
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

